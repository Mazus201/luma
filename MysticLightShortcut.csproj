<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Luma.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Luma.SmokeTests" />
    <Compile Remove="tests\**\*.cs" />
    <None Include="MysticLight_SDK_x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Luma.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
